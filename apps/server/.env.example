AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-xxx
AI_MODEL=gpt-4o-mini
PORT=15201

# 浏览器运行模式（web_search / web_fetch 工具使用）
# - 不设置或 true：无头模式（后台运行，无窗口）
# - false：显示浏览器窗口，方便调试页面抓取和搜索流程
# BROWSER_HEADLESS=true

# 本机浏览器调试地址（browser_* 工具连接用户已打开的真实浏览器）
# 默认 http://127.0.0.1:9222；需先以 --remote-debugging-port 启动浏览器（Windows 双击 scripts/start-browser-cdp.bat）
# 配置了本变量时默认启用浏览器控制；设置页「浏览器控制」里保存的值优先于 .env
# 浏览器跑在另一台机器（如 Windows）时填 http://<该机器 IP>:9222，并需在那边放开监听与防火墙
# BROWSER_CDP_URL=http://127.0.0.1:9222

# 语音服务（语音输入/朗读）的默认 API Key，阿里云百炼（DashScope）的 DASHSCOPE_API_KEY
# 设置页「语音」里保存的值优先于本变量；不配置时聊天框不显示麦克风按钮
# VOICE_API_KEY=sk-xxx
# 阿里云百炼工作空间 ID（百炼 2.0 账户需要）。配置后自动推导 ASR/TTS 接口地址，
# 无需在设置页手填；设置页保存的值优先于推导值
# WORKSPACE_ID=llm-xxxx
