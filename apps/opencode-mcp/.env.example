# opencode serve 地址；显式设置（如 http://127.0.0.1:4096）则不再由本进程 spawn
OPENCODE_URL=
# spawn opencode serve 时的端口 / 主机名 / 工作目录（默认仓库根）
OPENCODE_PORT=4096
OPENCODE_HOSTNAME=127.0.0.1
# OPENCODE_PROJECT_DIR=/path/to/project
# HTTP Basic auth（serve 与 MCP 客户端共用的凭据）
OPENCODE_USERNAME=opencode
# OPENCODE_PASSWORD=xxx

# 本 MCP 服务器监听配置
MCP_PORT=9410
# MCP_HOSTNAME=0.0.0.0
